{
  "name": "synex-client",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.11.1",
    "pnpm": "^12.11.2"
  },
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "commit": "commit",
    "mock-server": "nodemon --exec \"tsx\" mock-server/custom-middleware.ts --watch mock-server"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.28.3",
    "@auth0/nextjs-auth0": "^4.31.1",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/prompt-cli": "^21.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript/native": "npm:typescript@^7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "express": "^5.3.0",
    "express-delay": "^0.2.0",
    "glob": "^13.0.6",
    "husky": "^9.1.7",
    "json-server": "0.17.4",
    "lint-staged": "^17.6.0",
    "nodemon": "^3.1.14",
    "prettier": "3.9.9",
    "sass": "^1.105.1",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md,yml,yaml,html,mdx}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{json,css,scss,md,yml,yaml}": "prettier --write"
  }
}
